<?xml version="1.0" encoding="UTF-8"?>
<workout_file>
  <author>Plan 70.3 Monterrey</author>
  <name>Test de FTP · 20 minutos</name>
  <description>El test que fija todas tus zonas. Sal conservador y sube desde el minuto 5. Tu FTP es la potencia media de los 20 minutos multiplicada por 0,95.</description>
  <sportType>bike</sportType>
  <tags><tag name="70.3"/></tags>
  <workout>
    <Warmup Duration="1200" PowerLow="0.5" PowerHigh="0.7"/>
    <IntervalsT Repeat="3" OnDuration="60" OffDuration="120" OnPower="1.05" OffPower="0.5"/>
    <SteadyState Duration="300" Power="0.5"/>
    <SteadyState Duration="1200" Power="1.05"/>
    <Cooldown Duration="600" PowerLow="0.6" PowerHigh="0.4"/>
  </workout>
</workout_file>
