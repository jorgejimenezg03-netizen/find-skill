    <IntervalsT Repeat="3" OnDuration="60" OffDuration="120" OnPower="0.98" OffPower="0.5"/>
    <IntervalsT Repeat="3" OnDuration="600" OffDuration="300" OnPower="0.955" OffPower="0.5"/>
    <Cooldown Duration="600" PowerLow="0.6" PowerHigh="0.4"/>
  </workout>
</workout_file>
